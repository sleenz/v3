# Every setting the service reads (app/settings.py). Copy to .env (git-ignored) for local runs
# (uvicorn app.main:app --env-file .env) and scripts/live_check.py. Never commit .env.
# One line per setting, value right after the = (no quotes needed). Point it at the DEV sheet.
# Keep comments on their own line: a comment after an empty value is read as the value.
# In production: the non-secret values live in deploy/env.prod.yaml (secret grc-env-prod) and the
# secrets in Secret Manager (deploy/secrets.txt); Cloud Run sets them as these same variables.

# --- Google Cloud and the sheet (not secret) ---
# project ID
GCP_PROJECT=
# asia-southeast2 (Jakarta)
GCP_REGION=
# docs.google.com/spreadsheets/d/<this>/edit (the full URL also works)
SHEET_ID=
# only with Config "File storage" = Drive
SHARED_DRIVE_FOLDER_ID=
# https://v2-git-<project number>.asia-southeast2.run.app
SERVICE_URL=
# grc-tracker-scheduler@<project ID>.iam.gserviceaccount.com
SCHEDULER_SA_EMAIL=
# grc-tracker-run@<project ID>.iam.gserviceaccount.com
RUNTIME_SA_EMAIL=
# the project number
CHAT_PROJECT_NUMBER=
# optional: projects/<project ID>/topics/grc-gmail-push (instant email)
GMAIL_PUSH_TOPIC=

# --- WhatsApp bot (not secret; leave empty to keep the bot off) ---
# Meta app > WhatsApp > API setup > Phone number ID
WA_PHONE_NUMBER_ID=
# WhatsApp Business Account ID
WA_WABA_ID=
# the Meta app's Graph API version, e.g. v23.0
WA_GRAPH_VERSION=
# long random string, also typed into Meta's webhook settings
WA_VERIFY_TOKEN=
# Cloud Tasks queue, default wa-process
WA_TASKS_QUEUE=

# --- Secrets (production: Secret Manager, see deploy/secrets.txt) ---
# printed once by scripts/mint_gmail_token.py (starts with 1//)
GMAIL_REFRESH_TOKEN=
# the OAuth client JSON on one line; or use OAUTH_CLIENT_FILE below
OAUTH_CLIENT_SECRET=
# laptop only: FULL path to the downloaded OAuth client JSON
OAUTH_CLIENT_FILE=
# Google AI Studio key
GEMINI_API_KEY=
# Meta system-user permanent token
WA_ACCESS_TOKEN=
# Meta app secret
WA_APP_SECRET=
